{
  "name": "elevate-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:anon": "VITE_ANONYMOUS=true vite",
    "build": "npm run build:site",
    "build:site": "rm -rf dist && VITE_ANONYMOUS=true vite build --outDir dist/review && vite build --outDir dist/public && node scripts/root-redirect.mjs review/",
    "build:anon": "VITE_ANONYMOUS=true vite build",
    "build:public": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build:site",
    "deploy": "gh-pages -d dist -b gh-pages --nojekyll -u \"$(git config user.name) <$(git config user.email)>\""
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
